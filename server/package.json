    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.12.0",
    "socket.io": "^4.8.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.5",
    "@types/supertest": "^7.2.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
