{
  "name": "cucampussaathi-server",
  "version": "1.0.0",
  "description": "Backend service for CUCampusSaathi university collaboration platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "test": "vitest run --no-file-parallelism src/tests",
    "clean": "rimraf dist"
  },
  "keywords": [
    "cucampussaathi",
    "express",
    "mongoose",
    "mongodb"
  ],
  "author": "CUCampusSaathi Engineering",
  "license": "ISC",
